# Postgres for the sync ledger.
DATABASE_URL=postgres://localhost:5432/ghl_sync_dev
# Random string that forms the private webhook URL: /api/webhooks/optimantra/<WEBHOOK_SECRET>
WEBHOOK_SECRET=
# Optional comma-separated source IPs, once OptiMantra confirms its outbound addresses.
WEBHOOK_IP_ALLOWLIST=
# "mock" (default) or "live".
GHL_MODE=mock
GHL_API_VERSION=v3
# One Private Integration Token per sub-account, only for GHL_MODE=live.
GHL_TOKEN_LAKESIDE=
GHL_TOKEN_NORTHFIELD=
